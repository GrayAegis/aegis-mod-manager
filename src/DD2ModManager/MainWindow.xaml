<Window x:Class="DD2ModManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DD2ModManager"
        xmlns:vm="clr-namespace:DD2ModManager.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="DD2 Mod Manager" Width="1320" Height="820" MinWidth="980" MinHeight="600"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">

    <Window.Resources>
        <local:StatusBrushConverter x:Key="StatusBrush" />
        <local:EqualsConverter x:Key="EqualsConverter" />
        <local:VisibleWhenConverter x:Key="VisibleWhen" />

        <DataTemplate x:Key="StatusPill">
            <Border Style="{StaticResource Pill}" Background="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=bg}"
                    ToolTip="{Binding StatusReason}">
                <TextBlock Text="{Binding StatusText}" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"
                           FontSize="12" TextTrimming="CharacterEllipsis" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ChangelogEntry">
            <StackPanel Margin="0,0,0,12">
                <TextBlock>
                    <Run Text="{Binding VersionText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="   " /><Run Text="{Binding DateText, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                </TextBlock>
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" LineHeight="19" Foreground="#FFCFCAC1" Margin="0,3,0,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Requirement">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="Dot" Width="7" Height="7" Margin="0,6,10,0" VerticalAlignment="Top" Fill="{StaticResource MutedBrush}" />
                <StackPanel Grid.Column="1">
                    <TextBlock TextTrimming="CharacterEllipsis">
                        <Hyperlink Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                   CommandParameter="{Binding Url}" IsEnabled="{Binding HasUrl}" TextDecorations="{x:Null}"
                                   Foreground="{StaticResource TextBrush}" ToolTip="{Binding Url}">
                            <Run Text="{Binding Name, Mode=OneWay}" />
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"
                               Visibility="{Binding Detail, Converter={StaticResource VisibleWhen}}" />
                </StackPanel>
                <TextBlock x:Name="State" Grid.Column="2" Text="{Binding StatusText}" FontSize="12" Margin="10,1,0,0" VerticalAlignment="Top"
                           Foreground="{StaticResource MutedBrush}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="ok">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource SuccessBrush}" />
                    <Setter TargetName="State" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="missing">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource DangerBrush}" />
                    <Setter TargetName="State" Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Width="34" Height="34" VerticalAlignment="Center">
                    <Rectangle Width="24" Height="24" RadiusX="4" RadiusY="4" Fill="{StaticResource AccentBrush}">
                        <Rectangle.RenderTransform>
                            <RotateTransform Angle="45" CenterX="12" CenterY="12" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle Width="10" Height="10" Fill="{StaticResource PanelBrush}" RadiusX="1" RadiusY="1">
                        <Rectangle.RenderTransform>
                            <RotateTransform Angle="45" CenterX="5" CenterY="5" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Grid>

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Dragon's Dogma 2 Mod Manager" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding TotalCount, Mode=OneWay}" /><Run Text=" mods · " /><Run Text="{Binding InstalledCount, Mode=OneWay}" /><Run Text=" installed · " /><Hyperlink Command="{Binding OpenGameFolderCommand}" Foreground="{StaticResource MutedBrush}" TextDecorations="{x:Null}"><Run Text="{Binding GamePathText, Mode=OneWay}" /></Hyperlink>
                    </TextBlock>
                </StackPanel>

                <!-- Status chips -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Button Command="{Binding ManageREFrameworkCommand}" ToolTip="{Binding FrameworkTip}" Margin="0,0,8,0" Padding="10,4"
                            BorderBrush="Transparent" IsEnabled="{Binding IsBusy, Converter={x:Static local:Conv.Not}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="FrameworkIcon" FontSize="11" Margin="0,0,6,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                        <Setter Property="Text" Value="&#xE73E;" />
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FrameworkState}" Value="update">
                                                <Setter Property="Text" Value="&#xE896;" />
                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FrameworkState}" Value="missing">
                                                <Setter Property="Text" Value="&#xE711;" />
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FrameworkState}" Value="unknown">
                                                <Setter Property="Text" Value="&#xE73E;" />
                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding FrameworkText}" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource Pill}" Background="{StaticResource RaisedBrush}" Margin="0,0,8,0" Padding="10,4" ToolTip="{Binding PakLoadingTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0" Text="&#xE73E;" Foreground="{StaticResource SuccessBrush}"
                                       Visibility="{Binding PakLoadingOn, Converter={StaticResource VisibleWhen}}" />
                            <TextBlock Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0" Text="&#xE7BA;" Foreground="{StaticResource WarningBrush}"
                                       Visibility="{Binding PakLoadingOn, Converter={StaticResource VisibleWhen}, ConverterParameter=not}" />
                            <TextBlock Text="Pak loading" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Pill}" Background="{StaticResource RaisedBrush}" Padding="10,4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource MutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NexusConnected}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding NexusText}" FontSize="12" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding CheckUpdatesCommand}" Margin="0,0,8,0" IsEnabled="{Binding IsBusy, Converter={x:Static local:Conv.Not}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" Margin="0,0,8,0" />
                            <TextBlock Text="Check for updates" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AccentButton}" Command="{Binding UpdateAllCommand}" Margin="0,0,8,0"
                            IsEnabled="{Binding UpdateCount, Converter={x:Static local:Conv.Positive}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Margin="0,0,8,0" />
                            <TextBlock>
                                <Run Text="Update all" /><Run Text="{Binding UpdateCount, Mode=OneWay, StringFormat=' ({0})'}" />
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenSettingsCommand}" ToolTip="Settings" Padding="9,6">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="15" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="20,14,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="Search name, file or Nexus ID" Padding="30,7,8,7" />
                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Foreground="{StaticResource MutedBrush}" Margin="11,0,0,0" FontSize="13"
                           HorizontalAlignment="Left" IsHitTestVisible="False" />
            </Grid>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0" Padding="1">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" GroupName="filter"
                                 IsChecked="{Binding Filter, Converter={StaticResource EqualsConverter}, ConverterParameter=All}">
                        <TextBlock><Run Text="All " /><Run Text="{Binding TotalCount, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" /></TextBlock>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Segment}" GroupName="filter"
                                 IsChecked="{Binding Filter, Converter={StaticResource EqualsConverter}, ConverterParameter=Installed}">
                        <TextBlock><Run Text="Installed " /><Run Text="{Binding InstalledCount, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" /></TextBlock>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Segment}" GroupName="filter"
                                 IsChecked="{Binding Filter, Converter={StaticResource EqualsConverter}, ConverterParameter=Updates}">
                        <TextBlock><Run Text="Updates " /><Run Text="{Binding WithUpdatesCount, Mode=OneWay}" Foreground="{StaticResource WarningBrush}" /></TextBlock>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Segment}" GroupName="filter" Content="Not installed"
                                 IsChecked="{Binding Filter, Converter={StaticResource EqualsConverter}, ConverterParameter=NotInstalled}" />
                </StackPanel>
            </Border>

            <CheckBox Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" Content="Hide older versions"
                      IsChecked="{Binding HideOlderVersions}" ToolTip="Show one row per mod. Older archives are listed in the details panel." />

            <StackPanel Grid.Column="4" Orientation="Horizontal">
                <Button Command="{Binding AddModsCommand}" Margin="0,0,8,0" ToolTip="Add archives to the library (or drop them on the window)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Margin="0,0,8,0" />
                        <TextBlock Text="Add mods" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenModsFolderCommand}" Margin="0,0,8,0" ToolTip="Open the mods library folder">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" Margin="0,0,8,0" />
                        <TextBlock Text="Library" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding LaunchGameCommand}" ToolTip="Launch Dragon's Dogma 2 through Steam">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" Margin="0,0,8,0" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="Play" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main area -->
        <Grid Grid.Row="2" Margin="20,0,20,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="0,0,0,4">
                <DataGrid x:Name="ModGrid" ItemsSource="{Binding ItemsView}" SelectedItem="{Binding Selected}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="62" SortMemberPath="AnyInstalled">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding IsInstalled, Mode=OneWay}"
                                                  IsEnabled="{Binding CanToggle}"
                                                  Command="{Binding DataContext.ToggleInstallCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  CommandParameter="{Binding}" ToolTip="Install / uninstall" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Name" Width="*" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="12" Margin="8,0,0,0" Foreground="{StaticResource DangerBrush}"
                                                   ToolTip="{Binding MissingRequiredTip}" Visibility="{Binding HasMissingRequired, Converter={StaticResource VisibleWhen}}" />
                                        <TextBlock Text="{Binding PartsSummary}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="10,0,0,0"
                                                   VerticalAlignment="Center" Visibility="{Binding HasMultipleUnits, Converter={StaticResource VisibleWhen}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="90" />
                        <DataGridTemplateColumn Header="Status" Width="230" SortMemberPath="StatusSort" CellTemplate="{StaticResource StatusPill}" />
                        <DataGridTemplateColumn Header="Nexus" Width="64" SortMemberPath="ModIdText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ModIdText}" Foreground="{StaticResource MutedBrush}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Updated" Width="104" SortMemberPath="Updated">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding UpdatedText}" Foreground="{StaticResource MutedBrush}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Details -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <TextBlock Text="Select a mod to see its details" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Selected, Converter={StaticResource VisibleWhen}, ConverterParameter=not}" />
                    <ScrollViewer DataContext="{Binding Selected}" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding Converter={StaticResource VisibleWhen}}">
                        <StackPanel Margin="18">
                            <Border CornerRadius="6" Height="200" Background="{StaticResource RaisedBrush}" ClipToBounds="True">
                                <Grid>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xEB9F;" FontSize="36" Foreground="#FF3A4049" HorizontalAlignment="Center" />
                                    <Image Source="{Binding Screenshot}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.Clip>
                                            <RectangleGeometry Rect="0,0,362,200" RadiusX="6" RadiusY="6" />
                                        </Image.Clip>
                                    </Image>
                                </Grid>
                            </Border>

                            <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,16,0,2" />
                            <TextBlock Text="{Binding Byline}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />

                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StatusPill}" Margin="0,12,0,0" HorizontalAlignment="Left" />

                            <WrapPanel Margin="0,14,0,0">
                                <Button Style="{StaticResource AccentButton}" Margin="0,0,8,8"
                                        Command="{Binding DataContext.UpdateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                        Visibility="{Binding CanUpdate, Converter={StaticResource VisibleWhen}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding UpdateButtonText}" />
                                    </StackPanel>
                                </Button>
                                <Button Margin="0,0,8,8" Content="{Binding ToggleButtonText}" IsEnabled="{Binding CanToggle}"
                                        Command="{Binding DataContext.ToggleInstallCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                <Button Margin="0,0,8,8" Visibility="{Binding CanRollback, Converter={StaticResource VisibleWhen}}"
                                        Command="{Binding DataContext.RollbackCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding RollbackTarget}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding RollbackButtonText}" />
                                    </StackPanel>
                                </Button>
                                <Button Margin="0,0,8,8" Visibility="{Binding NexusUrl, Converter={StaticResource VisibleWhen}}"
                                        Command="{Binding DataContext.OpenNexusCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" Margin="0,0,8,0" />
                                        <TextBlock Text="Nexus page" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>

                            <StackPanel Visibility="{Binding ShowChangelogFirst, Converter={StaticResource VisibleWhen}}">
                                <TextBlock Text="{Binding ChangelogTitle}" Style="{StaticResource SectionLabel}" />
                                <ItemsControl ItemsSource="{Binding ChangelogEntries}" ItemTemplate="{StaticResource ChangelogEntry}" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding Requirements, Converter={StaticResource VisibleWhen}}">
                                <TextBlock Text="REQUIRES" Style="{StaticResource SectionLabel}" />
                                <ItemsControl ItemsSource="{Binding Requirements}" ItemTemplate="{StaticResource Requirement}" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding RequiredByText, Converter={StaticResource VisibleWhen}}">
                                <TextBlock Text="NEEDED BY" Style="{StaticResource SectionLabel}" />
                                <TextBlock Text="{Binding RequiredByText}" TextWrapping="Wrap" Foreground="#FFCFCAC1" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding Description, Converter={StaticResource VisibleWhen}}">
                                <TextBlock Text="DESCRIPTION" Style="{StaticResource SectionLabel}" />
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" LineHeight="19" Foreground="#FFCFCAC1" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding ShowChangelogLater, Converter={StaticResource VisibleWhen}}">
                                <TextBlock Text="{Binding ChangelogTitle}" Style="{StaticResource SectionLabel}" />
                                <ItemsControl ItemsSource="{Binding ChangelogEntries}" ItemTemplate="{StaticResource ChangelogEntry}" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding HasMultipleUnits, Converter={StaticResource VisibleWhen}}">
                                <TextBlock Text="PARTS" Style="{StaticResource SectionLabel}" />
                                <ItemsControl ItemsSource="{Binding Units}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ToggleButton Style="{StaticResource Switch}" IsThreeState="False" IsChecked="{Binding IsInstalled, Mode=OneWay}"
                                                              Command="{Binding DataContext.ToggleUnitCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Visibility="{Binding PreviousVersions, Converter={StaticResource VisibleWhen}}">
                                <TextBlock Text="KEPT FOR ROLLBACK" Style="{StaticResource SectionLabel}" />
                                <ItemsControl ItemsSource="{Binding PreviousVersions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Record.FileName}">
                                                    <Run Text="{Binding VersionText, Mode=OneWay}" FontWeight="Medium" /><Run Text="   " /><Run Text="{Binding Detail, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                                </TextBlock>
                                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Roll back" Padding="8,3" FontSize="12"
                                                        Command="{Binding DataContext.RollbackCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Visibility="{Binding OtherVersions, Converter={StaticResource VisibleWhen}}">
                                <TextBlock Text="OTHER VERSIONS IN LIBRARY" Style="{StaticResource SectionLabel}" />
                                <ItemsControl ItemsSource="{Binding OtherVersions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,2" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}">
                                                <Run Text="{Binding Version, Mode=OneWay, TargetNullValue='?'}" FontWeight="Medium" /><Run Text="   " /><Run Text="{Binding FileName, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Margin="0,8,0,0" HorizontalAlignment="Left" Content="Remove older versions"
                                        Visibility="{Binding RemovableVersions, Converter={StaticResource VisibleWhen}}"
                                        Command="{Binding DataContext.RemoveOlderVersionsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                            </StackPanel>

                            <TextBlock Text="DETAILS" Style="{StaticResource SectionLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Archive" Foreground="{StaticResource MutedBrush}" Margin="0,2" />
                                <TextBlock Grid.Column="1" Text="{Binding ArchiveName}" TextWrapping="Wrap" Margin="0,2" />
                                <TextBlock Grid.Row="1" Text="Size" Foreground="{StaticResource MutedBrush}" Margin="0,2" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SizeText}" Margin="0,2" />
                                <TextBlock Grid.Row="2" Text="Nexus" Foreground="{StaticResource MutedBrush}" Margin="0,2" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MatchText}" TextWrapping="Wrap" Margin="0,2" />
                                <TextBlock Grid.Row="3" Text="Files" Foreground="{StaticResource MutedBrush}" Margin="0,2" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FileCount}" Margin="0,2" />
                            </Grid>

                            <Expander Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}">
                                <Expander.Header>
                                    <TextBlock Text="Show files" Foreground="{StaticResource MutedBrush}" />
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding FileList}" Margin="4,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="#FFB5B0A6" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>

                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,14,0,0">
                                <DockPanel LastChildFill="False">
                                    <CheckBox DockPanel.Dock="Left" Content="Ignore updates" IsChecked="{Binding IgnoreUpdates, Mode=OneWay}"
                                              Visibility="{Binding Package, Converter={StaticResource VisibleWhen}}"
                                              Command="{Binding DataContext.ToggleIgnoreUpdatesCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Visibility="{Binding Package, Converter={StaticResource VisibleWhen}}"
                                            Command="{Binding DataContext.DeleteArchiveCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" Margin="0,0,8,0" />
                                            <TextBlock Text="Delete archive" />
                                        </StackPanel>
                                    </Button>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar Width="140" Margin="0,0,12,0" VerticalAlignment="Center" IsIndeterminate="{Binding ProgressIndeterminate}" Value="{Binding ProgressValue}"
                             Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}" />
                <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding QuotaText}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0" />
                <Button Grid.Column="3" Style="{StaticResource GhostButton}" Command="{Binding OpenLogCommand}" ToolTip="Open the log file" Padding="6,2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="12" Margin="0,0,6,0" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="Log" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
